# ==============================================================================
# Jewellery Catalog Audit Dashboard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or actual service account credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Service Account & Sheets Integration
# ------------------------------------------------------------------------------
# Path to your Google Cloud service account JSON file relative to project root
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-service-account.json

# (Alternative for Serverless/Cloud Deployments where local files are not mounted)
# Base64 encoded content of the service account JSON file
# GOOGLE_SERVICE_ACCOUNT_BASE64=

# Target Google Spreadsheet ID (from URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=1wKfFadJlQrMli9GTBljjb3m6HUJmazFG_uXAvFPsQlY

# Overview & Staging Sync Spreadsheets
GOOGLE_SHEET_EXPORT_DATA_ID=1gF5LTrq7u81-bk0F5C5LBjhYMqE5UtuQt43MIMj6LWI
GOOGLE_SHEET_MEDIA_ID=1ffR337uw0Uu2gCirNjdLSx12UP1z-ebS9Sr6hacoSdg
GOOGLE_SHEET_CUSTOM_OPTIONS_ID=1fMYF2bFljbvamNYVN_dFUmYDOj4yXzwdtG69CYoIXKw

# Main Product Sheet Tab Name (Default: Products)
GOOGLE_SHEET_NAME=Products

# Optional Google Drive Folder ID for backups and file archiving
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ------------------------------------------------------------------------------
# 2. Magento Staging Export Credentials (Read by server-side proxy only)
# ------------------------------------------------------------------------------
GEMPUNDIT_REPORT_USERNAME=your_staging_username
GEMPUNDIT_REPORT_PASSWORD=your_staging_password
GEMPUNDIT_REPORT_URL=https://staging.gempundit.com/var/export/report.csv

# ------------------------------------------------------------------------------
# 3. Server & Application Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
VITE_API_BASE_URL=http://localhost:3000
